@BankingApi_HostAddress = http://localhost:5163
@BankingApi_ProdHost = https://api.example.com

### ----- Production -----

GET {{BankingApi_ProdHost}}/api/Accounts
Accept: application/json

###

### ----- Accounts -----

GET {{BankingApi_HostAddress}}/api/Accounts
Accept: application/json

###

GET {{BankingApi_HostAddress}}/api/Accounts?include=transactions
Accept: application/json

###

GET {{BankingApi_HostAddress}}/api/Accounts?include=transactions&type=Credit
Accept: application/json

###

GET {{BankingApi_HostAddress}}/api/Accounts?include=transactions&type=Debit
Accept: application/json

###

GET {{BankingApi_HostAddress}}/api/Accounts/1
Accept: application/json

###

GET {{BankingApi_HostAddress}}/api/Accounts/2?include=transactions
Accept: application/json

###

GET {{BankingApi_HostAddress}}/api/Accounts/1?include=transactions,branch
Accept: application/json

###

GET {{BankingApi_HostAddress}}/api/Accounts/1?include=TRANSACTIONS
Accept: application/json

###

GET {{BankingApi_HostAddress}}/api/Accounts/1?include=transactions&type=Credit
Accept: application/json

###

GET {{BankingApi_HostAddress}}/api/Accounts/1?include=transactions&type=Debit
Accept: application/json

###

POST {{BankingApi_HostAddress}}/api/Accounts
Content-Type: application/json

{
}

###

PUT {{BankingApi_HostAddress}}/api/Accounts/1
Content-Type: application/json

{
  "id": 1,
  "accountNumber": "ACC-9999"
}

###

DELETE {{BankingApi_HostAddress}}/api/Accounts/1

###

